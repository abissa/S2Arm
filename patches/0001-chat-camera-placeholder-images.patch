+// ---------- nn::chat 摄像头视频图像的占位原生图像 ----------
+// 马里奥赛车 World（Switch 2）启动时按序号取 8 张摄像头视频图像（384x216）建 NVN 纹理，哪怕没有聊天。宿主没有摄像头：每个序号发一张宿主自己的占位图像
+//   （RGBA、全 0、不写内容），登记在解码图像同一张表里（cv_img_get 认得，nvnNativeImageInitialize / nvnTextureInitializeFromNativeImage 照常走）。
+//   远端 / 本地各一套序号。内存自己分配（16 KB 对齐、整页），不用游戏给的缓冲（宿主的 nn::chat 实现把缓冲大小算 0）
+#define CAM_W 384
+#define CAM_H 216
+#define CAM_IDX 16
+static uint32_t g_cam_handle[2][CAM_IDX];
+static uint32_t cv_cam_image(int remote, int index) {
+    remote = remote ? 1 : 0;
+    if (index < 0 || index >= CAM_IDX) { CV_RED(camidx, "Switch 2 GameChat：摄像头视频图像序号 %d 超出 0..%d，回无效句柄", index, CAM_IDX - 1); return 0; }
+    pthread_mutex_lock(&g_img_mu);
+    uint32_t h = g_cam_handle[remote][index];
+    if (h && g_img_used[h - 1]) { pthread_mutex_unlock(&g_img_mu); return h; }
+    pthread_mutex_unlock(&g_img_mu);
+    cv_img im; memset(&im, 0, sizeof im);
+    im.kind = IMG_RGBA; im.w = CAM_W; im.h = CAM_H;
+    im.pitch = (uint32_t)al((size_t)CAM_W * 4, 256);
+    im.chroma_off = (size_t)im.pitch * al(im.h, 16);
+    im.size = al(im.chroma_off, 0x4000);
+    void *mem = NULL;
+    if (posix_memalign(&mem, 0x4000, im.size)) die("Switch 2 GameChat：摄像头占位图像内存不足");
+    memset(mem, 0, im.size);
+    pthread_mutex_lock(&g_img_mu);
+    int p = -1; for (int i = 0; i < CV_POOLS; i++) if (!g_cvp[i].used) { p = i; break; }
+    uint32_t first = 0;
+    for (uint32_t k = 0; p >= 0 && k < CV_IMAGES && !first; k++) { uint32_t s = (g_img_next + k) % CV_IMAGES; if (!g_img_used[s]) first = s + 1; }
+    if (p >= 0 && first) {
+        g_cvp[p] = (typeof(g_cvp[p])){ .used = 1, .mem = (uint8_t *)mem, .size = im.size };
+        cv_img *e = &g_img[first - 1]; *e = im; e->mem = (uint8_t *)mem; e->host = (uint8_t *)mem; e->pool = p;
+        g_img_used[first - 1] = 1; g_img_next = first % CV_IMAGES; g_cam_handle[remote][index] = first;
+    }
+    pthread_mutex_unlock(&g_img_mu);
+    if (!first || p < 0) { free(mem); LOG("【红】Switch 2 GameChat：放不下摄像头占位图像（池记录 %s）", p < 0 ? "满" : "有空"); return 0; }
+    static _Atomic int said; if (atomic_fetch_add(&said, 1) < 2) LOG("Switch 2 GameChat：%s摄像头视频图像 %d → 宿主占位原生图像 %u（%dx%d RGBA，不写内容；宿主没有摄像头）", remote ? "远端" : "本地", index, first, CAM_W, CAM_H);
+    return first;
+}
+__attribute__((constructor)) static void cam_image_reg(void) { nvn2_cam_image_register(cv_cam_image); }
