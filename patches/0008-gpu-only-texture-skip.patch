+// S2Arm (fork): Switch 2 games map GPU-only (protected) memory with no CPU access; a texture living there must not be read for upload (the host faulted in span_hash: SIGBUS)
+static int guest_mem_readable(const void *p, size_t n) {
+    vm_address_t a = (vm_address_t)(uintptr_t)p, end = a + n;
+    while (a < end) {
+        vm_address_t ra = a; vm_size_t rs = 0; vm_region_basic_info_data_64_t vi; mach_msg_type_number_t cnt = VM_REGION_BASIC_INFO_COUNT_64; mach_port_t obj = MACH_PORT_NULL;
+        if (vm_region_64(mach_task_self(), &ra, &rs, VM_REGION_BASIC_INFO_64, (vm_region_info_t)&vi, &cnt, &obj) != KERN_SUCCESS) return 0;
+        if (ra > a || !(vi.protection & VM_PROT_READ)) return 0;
+        a = ra + rs;
+    }
+    return 1;
+}
