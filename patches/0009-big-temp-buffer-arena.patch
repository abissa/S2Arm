-    const uint8_t *src = t->mem; uint8_t *part = NULL;
+    const uint8_t *src = t->mem; uint8_t *part = NULL; size_t partn = t->L.size ? t->L.size : 1;
     if (sparse) {
-        if (!(part = malloc(t->L.size ? t->L.size : 1))) MDIE("sparse texture copy of %llu bytes failed", (unsigned long long)t->L.size);
+        if (!(part = big_alloc(partn))) MDIE("sparse texture copy of %llu bytes failed", (unsigned long long)t->L.size);
         nvn_sparse_copy(t->pool, part, (uint64_t)(uintptr_t)t->mem, t->L.size); src = part;
     }
     up_begin();
@@ -3205,7 +3220,7 @@ static id<MTLTexture> pkg_upload_(const tex_t *t, uint64_t *stamp, id<MTLTexture
             off += pitch * rows * z;
         }
