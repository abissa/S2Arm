     }
     return 1;
 }
+// S2Arm (fork): a temporary buffer as big as a sparse texture (400 MB for Mario Kart World) found no hole in the nearly full low region and malloc failed (FATAL). The virtual-pool arena
+//   (runtime/src/vawin.c, a contiguous reservation below the window) lends the address range; the pages are committed with mprotect and given back with the range
+void *s2a_vp_arena_map(uint64_t len) __attribute__((weak)); int s2a_vp_arena_has(const void *p, uint64_t n) __attribute__((weak)); void s2a_vp_arena_free(const void *p, uint64_t len) __attribute__((weak));
+static void *big_alloc(size_t n) {
+    void *p = malloc(n); if (p) return p;
+    if (!s2a_vp_arena_map) return NULL;
+    size_t r = (n + 16383) & ~(size_t)16383; p = s2a_vp_arena_map(r); if (!p) return NULL;
+    if (mprotect(p, r, PROT_READ | PROT_WRITE)) { s2a_vp_arena_free(p, r); return NULL; }
+    return p;
+}
+static void big_free(void *p, size_t n) {
+    if (!p) return;
+    size_t r = (n + 16383) & ~(size_t)16383;
+    if (s2a_vp_arena_has && s2a_vp_arena_has(p, r)) { mmap(p, r, PROT_NONE, MAP_ANON | MAP_PRIVATE | MAP_FIXED, -1, 0); s2a_vp_arena_free(p, r); } else free(p);
+}
 static id<MTLTexture> pkg_upload_(const tex_t *t, uint64_t *stamp, id<MTLTexture> reuse, uint64_t **ph, uint32_t *nph) {
     MTLTextureDescriptor *d = tex_desc(t, 1);
