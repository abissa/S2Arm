+// S2Arm (fork): a re-upload of a packaged sparse texture goes into the same texture when the level-layers that got pages since fit in its heap; only the level-layers whose mapping or physical pages
+//   changed go up again (before, every re-upload built a new heap + texture and sent every mapped level-layer again: 0.2 - 0.9 s stalls on Mario Kart World's virtual texture arrays)
+static int g_sp_incr; static uint64_t g_sp_incr_vgen, g_sp_incr_stamp;
+static int sparse_incr_ok(id<MTLTexture> mt, const tex_t *t) {
+    SpInfo *spi = sp_info(mt); if (!spi || !spi->heap || spi->gpu || spi->pool != t->pool || spi->base != (uint8_t *)t->mem || spi->size != t->L.size) return 0;
+    uint32_t nl = spi->td.levels ? spi->td.levels : 1; uint64_t need = 0; NSMutableIndexSet *tl = [NSMutableIndexSet indexSet];
+    for (unsigned l = 0; l < spi->nlev; l++) {
+        uint32_t w = MAX(spi->td.width >> l, 1u), h = MAX(spi->td.height >> l, 1u);
+        for (unsigned y = 0; y < spi->layers; y++) {
+            if ([spi->mapped containsIndex:(NSUInteger)l * spi->layers + y]) continue;
+            uint64_t lo = (uint64_t)y * spi->lsz + nvn_tex_level_offset(&spi->td, l), hi = l + 1 < nl ? (uint64_t)y * spi->lsz + nvn_tex_level_offset(&spi->td, l + 1) : (uint64_t)(y + 1) * spi->lsz;
+            if (hi <= lo || hi > spi->size || !nvn_sparse_any_mapped(spi->pool, (uint64_t)(uintptr_t)spi->base + lo, hi - lo)) continue;
+            if (l >= spi->tailFirst) { if ([spi->tailDone containsIndex:y] || [tl containsIndex:y]) continue; [tl addIndex:y]; need += spi->tailTiles; }
+            else need += (uint64_t)((w + spi->tw - 1) / spi->tw) * ((h + spi->th - 1) / spi->th);
+        }
+    }
+    return spi->used + need <= spi->cap;
+}
