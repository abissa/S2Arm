+// S2Arm (fork): the texels a 64 KB chunk of a sparse pool holds at one place are copied to another place that maps the same physical memory (hle_nvn.c phs_note). A chunk is one tile of a
+//   tiled level (64x64 blocks of 16 bytes, 128x64 of 8, 128x128 texels of 4, in rows across the level padded to whole tiles), or lies in the packed small levels: then those levels go whole
+typedef struct { const uint8_t *src, *dst; } sp_share_t;
+static sp_share_t *g_sps; static uint32_t g_sps_n, g_sps_cap; static os_unfair_lock g_sps_lk = OS_UNFAIR_LOCK_INIT; static _Atomic uint32_t g_sps_pending;
+void nvn_be_sparse_share(const uint8_t *src, const uint8_t *dst, uint64_t n) { (void)n;
+    os_unfair_lock_lock(&g_sps_lk);
+    if (g_sps_n == g_sps_cap) { uint32_t c = g_sps_cap ? g_sps_cap * 2 : 4096; sp_share_t *g = c <= (1u << 20) ? realloc(g_sps, c * sizeof *g) : NULL; if (!g) { os_unfair_lock_unlock(&g_sps_lk); return; } g_sps = g; g_sps_cap = c; }
+    g_sps[g_sps_n++] = (sp_share_t){src, dst}; atomic_store(&g_sps_pending, g_sps_n);
+    os_unfair_lock_unlock(&g_sps_lk);
+}
+typedef struct { __unsafe_unretained id<MTLTexture> tex; __unsafe_unretained SpInfo *spi; unsigned level, layer; uint32_t x, y, w, h; int tail; } sp_place;
+static int sp_locate(const uint8_t *va, sp_place *o) {
+    for (id<MTLTexture> mt in g_sp_all) { SpInfo *s = sp_info(mt); if (!s || va < s->base || va >= s->base + s->size || !s->lsz) continue;
+        uint64_t rel = (uint64_t)(va - s->base), layer = rel / s->lsz, in = rel % s->lsz; uint32_t nl = s->td.levels ? s->td.levels : 1; int bw, bh, bpb = nvn_fmt_bpb(s->td.format, &bw, &bh);
+        uint32_t tbw = bpb == 16 ? 64 : bpb == 8 || bpb == 4 ? 128 : 0, tbh = bpb == 16 || bpb == 8 ? 64 : bpb == 4 ? 128 : 0;
+        if (!tbw || layer >= s->layers) return 0;
+        for (unsigned l = 0; l < s->nlev && l < nl; l++) { uint64_t lo = nvn_tex_level_offset(&s->td, l), hi = l + 1 < nl ? nvn_tex_level_offset(&s->td, l + 1) : s->lsz;
+            if (in < lo || in >= hi) continue;
+            uint32_t w = MAX(s->td.width >> l, 1u), h = MAX(s->td.height >> l, 1u), wb = (w + (uint32_t)bw - 1) / (uint32_t)bw, hb = (h + (uint32_t)bh - 1) / (uint32_t)bh;
+            o->tex = mt; o->spi = s; o->level = l; o->layer = (unsigned)layer;
+            if (wb < tbw || hb < tbh) { o->tail = 1; o->x = o->y = 0; o->w = w; o->h = h; return 1; }
+            uint32_t nx = (wb + tbw - 1) / tbw; uint64_t k = (in - lo) / 0x10000; uint32_t tx = (uint32_t)(k % nx), ty = (uint32_t)(k / nx);
+            o->tail = 0; o->x = tx * tbw * (uint32_t)bw; o->y = ty * tbh * (uint32_t)bh; if (o->x >= w || o->y >= h) return 0;
+            o->w = MIN(tbw * (uint32_t)bw, w - o->x); o->h = MIN(tbh * (uint32_t)bh, h - o->y); return 1; }
+        return 0; }
+    return 0;
+}
+static void sp_share_run(void) {
+    sp_share_t *jobs; uint32_t n;
+    os_unfair_lock_lock(&g_sps_lk); jobs = g_sps; n = g_sps_n; g_sps = NULL; g_sps_n = g_sps_cap = 0; atomic_store(&g_sps_pending, 0); os_unfair_lock_unlock(&g_sps_lk);
+    if (!jobs) return;
+    static uint64_t done, miss, tails, same; int began = 0;
+    for (uint32_t i = 0; i < n && g_sp_all; i++) { sp_place s, d;
+        if (!sp_locate(jobs[i].src, &s) || !sp_locate(jobs[i].dst, &d)) { miss++; continue; }
+        if (s.tex == d.tex && s.level == d.level && s.layer == d.layer && s.x == d.x && s.y == d.y) { same++; continue; }
+        if (s.tex.pixelFormat != d.tex.pixelFormat || s.tail != d.tail || (!s.tail && (s.w != d.w || s.h != d.h)) || (s.tail && (s.level != d.level || s.tex.width != d.tex.width || s.tex.height != d.tex.height))) { miss++; continue; }
+        sparse_map_pending(d.spi, d.tex);
+        if (!began) { up_begin(); began = 1; }
+        if (!g_up_ce) { miss++; continue; }
+        if (!s.tail) { enc_b_copy_texture(g_up_ce, s.tex, s.layer, s.level, MTLOriginMake(s.x, s.y, 0), MTLSizeMake(s.w, s.h, 1), d.tex, d.layer, d.level, MTLOriginMake(d.x, d.y, 0)); done++; }
+        else { for (NSUInteger l = s.level; l < s.tex.mipmapLevelCount && l < d.tex.mipmapLevelCount; l++) { NSUInteger w = MAX(s.tex.width >> l, (NSUInteger)1), h = MAX(s.tex.height >> l, (NSUInteger)1);
+                   enc_b_copy_texture(g_up_ce, s.tex, s.layer, l, MTLOriginMake(0, 0, 0), MTLSizeMake(w, h, 1), d.tex, d.layer, l, MTLOriginMake(0, 0, 0)); }
+               done++; tails++; }
+        [g_up_texs addObject:s.tex]; [g_up_texs addObject:d.tex];
+    }
+    free(jobs);
+    if (began) up_flush();
+    { static uint64_t said; if (said++ < 30 || said % 300 == 0) MLOG("[vt-share] %u requests: %llu copies in all (%llu of the small levels), %llu not placed, %llu already the same place", n, (unsigned long long)done, (unsigned long long)tails, (unsigned long long)miss, (unsigned long long)same); }
+}
