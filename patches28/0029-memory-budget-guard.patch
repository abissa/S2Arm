+// S2Arm (fork): memory-budget guard. os_proc_available_memory() is how far the process is from the per-app limit (12.3 GB on the 12 GB iPad; the machine itself has 11.5 GB, and the system killed the game
+//   when a rebuild of a big sparse texture added its new copy to the old one at a footprint of 10.3 GB). A rebuild asks first: enough room for the new texture + staging + 512 MB margin? If not, idle
+//   textures go first, and if that is not enough the rebuild is postponed (the old texture keeps being sampled; retried every 30 frames) instead of the app being killed. S2A_MEM_GUARD=0 turns it off
+static uint64_t g_rb_skip_ser[8], g_rb_skip_fr[8];
+static int rb_guard_ok(NvPkg *pk, const tex_t *t) {
+    static int on = -1; if (on < 0) { const char *e_ = getenv("S2A_MEM_GUARD"); on = !(e_ && !strcmp(e_, "0")); }
+    if (!on) return 1;
+    uint64_t av = os_proc_available_memory(); if (!av) return 1;   // Mac: unknown
+    SpInfo *s = sp_info(pk->tex); uint64_t need = s ? s->used * s->tileBytes : (uint64_t)pk->tex.allocatedSize; need += need / 6 + (384ull << 20);
+    uint64_t fr = atomic_load(&g_cur_frame); int slot = -1;
+    for (int i = 0; i < 8; i++) if (g_rb_skip_ser[i] == t->serial) slot = i;
+    if (slot >= 0 && fr - g_rb_skip_fr[slot] < 30) return 0;   // asked a moment ago and there was not enough
+    if (av >= need + (512ull << 20)) return 1;
+    mem_evict_idle_ex(30, 64ull << 10);
+    uint64_t av2 = os_proc_available_memory();
+    if (av2 >= need + (512ull << 20)) return 1;
+    if (slot < 0) { for (int i = 0; i < 8; i++) if (!g_rb_skip_ser[i]) { slot = i; break; } if (slot < 0) slot = 0; }
+    g_rb_skip_ser[slot] = t->serial; g_rb_skip_fr[slot] = fr;
+    static int said; if (said++ < 60) MLOG("[mem] rebuild of sparse texture ser=%llu postponed: needs about %llu MB, %llu MB available (%llu MB after freeing idle textures)", (unsigned long long)t->serial, (unsigned long long)(need >> 20), (unsigned long long)(av >> 20), (unsigned long long)(av2 >> 20));
+    return 0;
+}
