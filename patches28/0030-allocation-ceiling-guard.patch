          (unsigned long long)(tb >> 20), (unsigned long long)tn, (unsigned long long)(bb >> 20), (unsigned long long)bn, (unsigned long long)(lb >> 20), (unsigned long long)ln);
@@ -4371,6 +4377,7 @@ static void mem_report(void) {
 //   when a rebuild of a big sparse texture added its new copy to the old one at a footprint of 10.3 GB). A rebuild asks first: enough room for the new texture + staging + 512 MB margin? If not, idle
