+    static int said; if (said++ < 60) MLOG("[mem] rebuild of sparse texture ser=%llu postponed: needs about %llu MB, %llu MB available (%llu MB after freeing idle textures); device allocation %llu MB", (unsigned long long)t->serial, (unsigned long long)(need >> 20), (unsigned long long)(av >> 20), (unsigned long long)(av2 >> 20), (unsigned long long)(g_dev.currentAllocatedSize >> 20));
     return 0;
 }
