 static uint64_t g_rb_skip_ser[8], g_rb_skip_fr[8];
+static int rb_alloc_ok(SpInfo *s) { if (!s) return 1; uint64_t minb = (s->used * s->tileBytes) * 21 / 20 + (32ull << 20); return g_dev.currentAllocatedSize + minb <= (18000ull << 20); }   // the new heap at its smallest on top of the old one still counted
 static int rb_guard_ok(NvPkg *pk, const tex_t *t) {
     static int on = -1; if (on < 0) { const char *e_ = getenv("S2A_MEM_GUARD"); on = !(e_ && !strcmp(e_, "0")); }
