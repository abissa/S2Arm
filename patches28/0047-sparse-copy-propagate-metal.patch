+    uint32_t nl = s->td.levels ? s->td.levels : 1; if (level >= nl || level >= s->nlev) return;
+    int bw, bh, bpb = nvn_fmt_bpb(s->td.format, &bw, &bh);
+    uint32_t tbw = bpb == 16 ? 64 : bpb == 8 || bpb == 4 ? 128 : 0, tbh = bpb == 16 || bpb == 8 ? 64 : bpb == 4 ? 128 : 0; if (!tbw) return;
+    uint32_t w = MAX(s->td.width >> level, 1u), h = MAX(s->td.height >> level, 1u), wb = (w + (uint32_t)bw - 1) / (uint32_t)bw, hb = (h + (uint32_t)bh - 1) / (uint32_t)bh;
+    uint64_t lo = nvn_tex_level_offset(&s->td, level); int tail = wb < tbw || hb < tbh;
+    uint32_t tw = tbw * (uint32_t)bw, th = tbh * (uint32_t)bh, nx = tail ? 1 : (wb + tbw - 1) / tbw;
+    uint32_t x0 = tail ? 0 : (uint32_t)MAX(c->dr.xoffset, 0) / tw, y0 = tail ? 0 : (uint32_t)MAX(c->dr.yoffset, 0) / th;
+    uint32_t x1 = tail ? 0 : ((uint32_t)MAX(c->dr.xoffset, 0) + (uint32_t)MAX(c->dr.width, 1) - 1) / tw, y1 = tail ? 0 : ((uint32_t)MAX(c->dr.yoffset, 0) + (uint32_t)MAX(c->dr.height, 1) - 1) / th;
+    static uint64_t done, tails, asked; id<MTL4ComputeCommandEncoder> b = nil;
+    for (unsigned y = layer0; y < layer0 + nlay && y < s->layers; y++) for (uint32_t ty = y0; ty <= y1; ty++) for (uint32_t tx = x0; tx <= x1; tx++) {
+        const uint8_t *va = s->base + (uint64_t)y * s->lsz + lo + (tail ? 0 : (uint64_t)(ty * nx + tx) * 0x10000), *pl[4]; asked++;
