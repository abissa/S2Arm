+// The Metal tile of 64 KB chunk idx of the texture: level, slice and the region in tiles. 0 when the chunk maps no tile of its own (the padding of a level, the rest of the mip tail)
+static int vs_chunk_region(const SpInfo *s, uint64_t idx, unsigned *lev, unsigned *slice, MTLRegion *rg) {
+    uint64_t o = idx * 65536ull; unsigned y = (unsigned)(o / s->lsz); if (y >= s->layers) return 0;
+    uint64_t in = o - (uint64_t)y * s->lsz; uint32_t nl = s->td.levels ? s->td.levels : 1;
+    for (unsigned l = 0; l < s->nlev && l < nl; l++) {
+        uint64_t lo = nvn_tex_level_offset(&s->td, l), hi = l + 1 < nl ? nvn_tex_level_offset(&s->td, l + 1) : s->lsz;
+        if (in < lo || in >= hi) continue;
+        if (l >= s->tailFirst) { if (in != nvn_tex_level_offset(&s->td, (uint32_t)s->tailFirst)) return 0; *lev = (unsigned)s->tailFirst; *slice = y; *rg = MTLRegionMake3D(0, 0, 0, 1, 1, 1); return 1; }
