+    if (!g_vs_h) return ~0u;
+    for (uint32_t p = 0, i = vs_hash(k, f); p < VS_HN; p++, i = (i + 1) & (VS_HN - 1)) { vs_h_t *e = &g_vs_h[i]; if (!e->slot1) return ~0u; if (e->slot1 != ~0u && e->key == k && e->fmt == f) return e->slot1 - 1; }
