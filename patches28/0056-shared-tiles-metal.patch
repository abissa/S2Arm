+}
+static void vs_dealloc(SpInfo *s) {
+    if (!s->sh) return;
+    VST("vs_dealloc %ux%ux%u", s->td.width, s->td.height, s->layers);
+    pthread_mutex_lock(&g_vs_mu);
+    if (s->sslot) for (uint64_t i = 0; i < s->nchunks; i++) if (s->sslot[i]) vs_release(s->sslot[i] - 1);
+    pthread_mutex_unlock(&g_vs_mu);
+    free(s->sslot); free(s->skey); free(s->nkey); s->sslot = NULL; s->skey = s->nkey = NULL;
+}
