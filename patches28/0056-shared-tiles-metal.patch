+        if ((uint64_t)tx * s->ntw >= w || (uint64_t)ty * s->nth >= h) return 0;
+        *lev = l; *slice = y; *rg = MTLRegionMake3D(tx, ty, 0, 1, 1, 1); return 1;
+    }
+    return 0;
+}
+typedef struct { __unsafe_unretained id<MTLHeap> heap; MTL4UpdateSparseTextureMappingOperation *op; size_t n, cap; } vs_ops;
+static void vs_op(vs_ops *o, MTL4UpdateSparseTextureMappingOperation x) {
+    if (o->n == o->cap) { o->cap = o->cap ? 2 * o->cap : 64; o->op = realloc(o->op, o->cap * sizeof *o->op); if (!o->op) MDIE("the shared mapping operations"); }
+    o->op[o->n++] = x;
+}
+// The chunks whose memory changed since the last look get their tiles: unmapped (the old slot given back), mapped (the slot of the memory behind the chunk, shared with every other place of it)
+static void sparse_map_shared(SpInfo *s, id<MTLTexture> mt) {
+    uint64_t g = nvn_sparse_gen(); if (s->scan_gen == g + 1) return;
+    if (!s->skey) return;
+    VST("map_shared enter %ux%ux%u fmt %#x gen %llu", s->td.width, s->td.height, s->layers, s->td.format, (unsigned long long)g);
+    uint64_t changed = nvn_sparse_chunk_keys(s->pool, (uint64_t)(uintptr_t)s->base, s->size, s->skey, s->nkey); s->scan_gen = g + 1;
