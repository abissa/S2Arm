+static void vs_release(uint32_t slot) {   // caller holds g_vs_mu; the GPU may still read the tile through work already committed: it is free once past the next fence
+    vs_tab_t *e = &g_vs_tab[slot]; if (e->rc > 1) { e->rc--; return; }
+    if (e->key) vs_del(e->key, e->fmt);
+    e->rc = 0; e->key = 0;
+    if (g_vs_nlate == g_vs_latecap) { g_vs_latecap = g_vs_latecap ? 2 * g_vs_latecap : 1024; g_vs_late = realloc(g_vs_late, g_vs_latecap * sizeof *g_vs_late); if (!g_vs_late) MDIE("the shared tile free list"); }
