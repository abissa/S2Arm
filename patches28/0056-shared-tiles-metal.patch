+static void vs_del(uintptr_t k, uint32_t f) {
+    if (!g_vs_h) return;
+    for (uint32_t p = 0, i = vs_hash(k, f); p < VS_HN; p++, i = (i + 1) & (VS_HN - 1)) { vs_h_t *e = &g_vs_h[i]; if (!e->slot1) return; if (e->slot1 != ~0u && e->key == k && e->fmt == f) { e->slot1 = ~0u; return; } }
