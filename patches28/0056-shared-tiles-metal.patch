+        vs_ops un = {0}; vs_ops *mp = NULL; uint32_t nh = 0; uint64_t nmap = 0, nun = 0, nsh = 0, nfail = 0;
+        pthread_mutex_lock(&g_vs_mu);
+        for (uint64_t i = 0; i < s->nchunks; i++) {
+            if (s->nkey[i] == s->skey[i]) continue;
