+                for (int k = 0; k < 128 * 128; k++) { const __fp16 *q = px + ((size_t)l * 128 * 128 + k) * 4; for (int c = 0; c < 4; c++) { float v = (float)q[c]; if (v != v) v = 1e9f; if (fabsf(v) > mx[c]) mx[c] = fabsf(v); }
+                    float y = (float)q[1]; if (y == y) { if (y < ymin) ymin = y; if (y > ymax) ymax = y; } if (fabsf((float)q[1]) > 50.0f) big++; }
+                MLOG("[sky-array] frame %llu ser=%llu layer %d: max |x| %.3f |y| %.3f |z| %.3f |w| %.3f, y from %.3f to %.3f, %d of 16384 texels with |y| > 50", (unsigned long long)fr, (unsigned long long)sers[i], l, mx[0], mx[1], mx[2], mx[3], ymin, ymax, big); }
