+// S2Arm (fork): switches without an environment. <Documents>/s2a_switches.txt (S2A_DOCS, else $HOME/Documents) holds lines NAME=VALUE (# comments); each becomes an environment variable unless the launch already set it, so a game
+//   started from the home screen can test one switch after another by editing that file (the launch's own --env wins). Read before main; logged with the first memory report
+static char g_sw_note[700];
+__attribute__((constructor)) static void s2a_switches_load(void) {
+    const char *dd = getenv("S2A_DOCS"), *hh = getenv("HOME"); char p[1200];
+    if (dd && *dd) snprintf(p, sizeof p, "%s/s2a_switches.txt", dd); else if (hh && *hh) snprintf(p, sizeof p, "%s/Documents/s2a_switches.txt", hh); else return;
+    FILE *f = fopen(p, "r"); if (!f) return;
+    char ln[300]; size_t o = 0;
+    while (fgets(ln, sizeof ln, f)) {
+        char *s = ln; while (*s == ' ' || *s == 9) s++;
+        if (!*s || *s == '#' || *s == 10 || *s == 13) continue;
+        char *eq = strchr(s, '='); if (!eq) continue;
+        *eq = 0; char *v = eq + 1; v[strcspn(v, "\r\n")] = 0;
+        size_t kl = strlen(s); while (kl && (s[kl - 1] == ' ' || s[kl - 1] == 9)) s[--kl] = 0;
+        if (!*s) continue;
+        int had = getenv(s) != NULL; if (!had) setenv(s, v, 0);
+        if (o < sizeof g_sw_note - 80) o += snprintf(g_sw_note + o, sizeof g_sw_note - o, " %s=%s%s", s, v, had ? "(launch env wins)" : "");
+    }
+    fclose(f);
+}
