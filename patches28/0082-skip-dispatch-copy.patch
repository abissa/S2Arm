     g_wr_epoch++; g_mdx_epoch++;
     if (c->tex) xv_check(c->tex->serial, c->has_view && c->view.set_levels ? c->view.base_level : 0, c->has_view && c->view.set_layers ? c->view.min_layer : 0, "texture-to-buffer copy");
@@ -14663,6 +14681,7 @@ int nvn_be_tex_storage_read(const void *nvntex, uint8_t *dst, size_t row) {
 }
 void nvn_be_rs_mark_bad(const void *nvntex) { const tex_t *t = nvntex; if (t && t->magic == MAGIC('T', 'E', 'X', 0)) rs_bad(tex_mtl(t), "测试标记"); }
 static void copy_b2t(const p_copy_b2t *c) {
+    if (ss_hit(&g_ss_copy)) return;
     if (c->tex && c->tex->pool && (c->tex->pool->flags & NVN_MEMORY_POOL_FLAGS_VIRTUAL)) { static uint64_t n_; n_++; if (n_ <= 40 || n_ % 1000 == 0) MLOG("[vt-copy] buffer -> texture #%llu frame %llu: ser=%llu %ux%ux%u format %#x pool flags %#x, region %d,%d,%d %dx%dx%d level %u", (unsigned long long)n_, (unsigned long long)atomic_load(&g_cur_frame), (unsigned long long)c->tex->serial, c->tex->d.width, c->tex->d.height, c->tex->d.depth, (unsigned)c->tex->d.format, c->tex->pool->flags, c->r.xoffset, c->r.yoffset, c->r.zoffset, c->r.width, c->r.height, c->r.depth, c->has_view && c->view.set_levels ? (unsigned)c->view.base_level : 0u); }   // S2Arm (fork) diagnostic
     if (fold_copy_skip(c->tex, "buffer→texture copy")) return;
     if (c->tex) zskip_del(c->tex->serial);
@@ -14810,6 +14829,7 @@ static uint64_t g_wd_copy_full, g_wd_copy_part;
