 static void dlss_eval(const p_dlss *d, uint32_t size);   // nvn_dlss.inc
 static void copy_t2t(const p_copy_t2t *c) {
+    if (ss_hit(&g_ss_copy)) return;
     { int sv_ = c->src && c->src->pool && (c->src->pool->flags & NVN_MEMORY_POOL_FLAGS_VIRTUAL), dv_ = c->dst && c->dst->pool && (c->dst->pool->flags & NVN_MEMORY_POOL_FLAGS_VIRTUAL);
       if (sv_ || dv_) { static uint64_t n_; n_++; if (n_ <= 40 || n_ % 1000 == 0) MLOG("[vt-copy] texture -> texture #%llu frame %llu: src ser=%llu %ux%u format %#x%s -> dst ser=%llu %ux%u format %#x%s, region %dx%dx%d", (unsigned long long)n_, (unsigned long long)atomic_load(&g_cur_frame), (unsigned long long)c->src->serial, c->src->d.width, c->src->d.height, (unsigned)c->src->d.format, sv_ ? " (virtual pool)" : "", (unsigned long long)c->dst->serial, c->dst->d.width, c->dst->d.height, (unsigned)c->dst->d.format, dv_ ? " (virtual pool)" : "", c->dr.width, c->dr.height, c->dr.depth); } }   // S2Arm (fork) diagnostic
