+// S2Arm (fork) S2A_SKIP_DISP / S2A_SKIP_COPY=<first frame>:<a>-<b>,...: the same schedule as S2A_SKIP_SCHED, for compute dispatches and for texture / buffer copies (one count per frame each): in frame first+k the operations
+//   a..b of that frame are dropped. Used to find what writes the flat "wall" that no draw paints (Mario Kart World). The picture is wrong on purpose
+typedef struct { const char *env; const char *name; long first; int n; long a[128], b[128]; long lastf, cnt; int init; } ss_t;
+static int ss_hit(ss_t *s) {
+    if (!s->init) { s->init = 1; s->first = -1; s->lastf = -1; const char *e_ = getenv(s->env), *c_ = e_ ? strchr(e_, 58) : NULL;
+        if (c_) { s->first = atol(e_); for (const char *q_ = c_ + 1; *q_ && s->n < 128;) { s->a[s->n] = atol(q_); const char *d_ = strchr(q_, 45); s->b[s->n] = d_ ? atol(d_ + 1) : s->a[s->n]; s->n++; const char *n_ = strchr(q_, 44); if (!n_) break; q_ = n_ + 1; }
+            MLOG("%s: from frame %ld, %d ranges", s->env, s->first, s->n); } }
+    if (s->first < 0 || !s->n || g_defer_replaying) return 0;
+    long fr_ = (long)atomic_load(&g_cur_frame);
+    if (fr_ != s->lastf) { if (s->lastf >= s->first && s->lastf < s->first + s->n) MLOG("[%s] frame %ld saw %ld ops", s->name, s->lastf, s->cnt); s->lastf = fr_; s->cnt = 0;
+        if (fr_ >= s->first && fr_ < s->first + s->n) MLOG("[%s] frame %ld drops ops #%ld-#%ld", s->name, fr_, s->a[fr_ - s->first], s->b[fr_ - s->first]); }
+    s->cnt++;
+    if (fr_ < s->first || fr_ >= s->first + s->n) return 0;
+    return s->cnt >= s->a[fr_ - s->first] && s->cnt <= s->b[fr_ - s->first];
+}
+static ss_t g_ss_disp = { "S2A_SKIP_DISP", "skipdisp" }, g_ss_copy = { "S2A_SKIP_COPY", "skipcopy" };
