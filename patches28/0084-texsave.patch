+// S2Arm (fork) S2A_TEXSAVE=<frame>: at the first draw of that frame, every sparse 2D array texture bound to a pixel shader slot is sampled layer by layer at mip levels 0 and 5 into a contact sheet (8 columns of 128 px tiles),
+//   saved as <documents>/shots/tex_<serial*10+level>.png. Levels that are not mapped / not filled show as black or wrong: looks for the fine data of the scenery arrays (Mario Kart World's 8192x8192x68 textures)
+static void fit_shot_png(const char *name, int k, uint64_t n, const char *what, const uint8_t *p, size_t w, size_t h, size_t row);
+static void texsave_one(id<MTLTexture> t, uint64_t ser, unsigned level) {
+    @autoreleasepool {
+        unsigned layers = (unsigned)t.arrayLength, cols = 8, rows = (layers + cols - 1) / cols, tile = 128; if (!layers || layers > 256) return;
+        static id<MTLRenderPipelineState> ps; static id<MTLCommandQueue> q;
+        if (!ps) { NSError *er = nil;
+            NSString *src = @"#include <metal_stdlib>\nusing namespace metal;\nstruct VO { float4 p [[position]]; float2 uv; };\n"
+                "vertex VO tv(uint v [[vertex_id]]) { float2 q = float2((v << 1) & 2, v & 2); VO o; o.p = float4(q * 2.0 - 1.0, 0, 1); o.uv = float2(q.x, 1.0 - q.y); return o; }\n"
+                "fragment float4 tf(VO i [[stage_in]], texture2d_array<float> t [[texture(0)]], constant uint2 &a [[buffer(0)]]) { constexpr sampler s(filter::linear, mip_filter::nearest); return float4(t.sample(s, i.uv, a.x, level(float(a.y))).rgb, 1.0); }\n";
+            id<MTLLibrary> lib = [g_dev newLibraryWithSource:src options:nil error:&er]; if (!lib) { MLOG("[texsave] library: %s", er.localizedDescription.UTF8String); return; }
+            MTLRenderPipelineDescriptor *pd = [MTLRenderPipelineDescriptor new]; pd.vertexFunction = [lib newFunctionWithName:@"tv"]; pd.fragmentFunction = [lib newFunctionWithName:@"tf"]; pd.colorAttachments[0].pixelFormat = MTLPixelFormatBGRA8Unorm;
+            ps = [g_dev newRenderPipelineStateWithDescriptor:pd error:&er]; if (!ps) { MLOG("[texsave] pipeline: %s", er.localizedDescription.UTF8String); return; }
+            q = [g_dev newCommandQueue]; if (g_res) [q addResidencySet:g_res]; }
+        MTLTextureDescriptor *td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm width:cols * tile height:rows * tile mipmapped:NO];
+        td.usage = MTLTextureUsageRenderTarget; td.storageMode = MTLStorageModeShared; id<MTLTexture> out = [g_dev newTextureWithDescriptor:td]; if (!out) return;
+        MTLRenderPassDescriptor *rp = [MTLRenderPassDescriptor renderPassDescriptor]; rp.colorAttachments[0].texture = out; rp.colorAttachments[0].loadAction = MTLLoadActionClear; rp.colorAttachments[0].clearColor = MTLClearColorMake(1, 0, 1, 1); rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+        id<MTLCommandBuffer> cb = [q commandBuffer]; id<MTLRenderCommandEncoder> e = [cb renderCommandEncoderWithDescriptor:rp]; [e setRenderPipelineState:ps]; [e setFragmentTexture:t atIndex:0];
+        for (unsigned l = 0; l < layers; l++) { MTLViewport vp = { (double)((l % cols) * tile), (double)((l / cols) * tile), (double)tile, (double)tile, 0, 1 }; [e setViewport:vp]; uint32_t a[2] = { l, level }; [e setFragmentBytes:a length:8 atIndex:0]; [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3]; }
+        [e endEncoding]; [cb commit]; [cb waitUntilCompleted];
+        if (cb.status != MTLCommandBufferStatusCompleted) { MLOG("[texsave] ser %llu level %u: command buffer status %d", (unsigned long long)ser, level, (int)cb.status); return; }
+        size_t row = (size_t)cols * tile * 4; uint8_t *buf = malloc(row * rows * tile); if (!buf) return;
+        [out getBytes:buf bytesPerRow:row fromRegion:MTLRegionMake2D(0, 0, cols * tile, rows * tile) mipmapLevel:0];
+        fit_shot_png("tex", (int)(ser * 10 + level), 0, "tex", buf, cols * tile, rows * tile, row); free(buf);
+    }
