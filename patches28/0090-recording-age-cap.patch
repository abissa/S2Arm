+// S2Arm (fork): Zelda (iPhone) kept about 11 recordings per frame alive for good (378,594 live in 371 MB of host blocks after 34,500 frames; the low 2 GB address region filled and the run
+//   ended in "mmap of a 2097152-byte host chunk failed"). A recording dies only when the game's memory under it is written again or its pool is finalized.
+//   sh_age_report (with DM_NVN_CMDSTAT) says how old the live ones are and what they hold; sh_evict (S2A_REC_CAP_MB=<MB>, off by default; S2A_REC_AGE=<frames>, default 6000) frees the oldest
+//   ended recordings, oldest first, while the live host blocks exceed the cap and the oldest is older than the age: a game that submits a handle that old again would run freed blocks
+static uint64_t g_sh_evicted;
+static void sh_age_report(uint64_t f) {
+    pthread_mutex_lock(&g_sh_mu);
+    static const uint64_t lim[3] = {120, 1200, 6000}; uint64_t n[4] = {0}, b[4] = {0}, one[4] = {0}, noiv[4] = {0}; srec *old[3] = {0}; int no = 0;
+    for (srec *r = g_sh_all.next; r != &g_sh_all; r = r->next) {   // oldest first
+        if (r->open) continue;
+        uint64_t age = f - r->born; int k = age < lim[0] ? 0 : age < lim[1] ? 1 : age < lim[2] ? 2 : 3;
+        n[k]++; b[k] += r->bytes; one[k] += r->niv == 1 && r->iv[0].hi - r->iv[0].lo == 1; noiv[k] += r->niv == 0;
+        if (no < 3) old[no++] = r;
+    }
+    LOG("[nvn] live recordings by age at frame %llu (ended, MB of host blocks; one-byte anchors; none): <120 frames %llu / %.1f / %llu / %llu, <1200 %llu / %.1f / %llu / %llu, <6000 %llu / %.1f / %llu / %llu, older %llu / %.1f / %llu / %llu; freed by the age cap so far %llu",
+        (unsigned long long)f, (unsigned long long)n[0], b[0] / 1048576.0, (unsigned long long)one[0], (unsigned long long)noiv[0], (unsigned long long)n[1], b[1] / 1048576.0, (unsigned long long)one[1], (unsigned long long)noiv[1],
+        (unsigned long long)n[2], b[2] / 1048576.0, (unsigned long long)one[2], (unsigned long long)noiv[2], (unsigned long long)n[3], b[3] / 1048576.0, (unsigned long long)one[3], (unsigned long long)noiv[3], (unsigned long long)g_sh_evicted);
+    for (int i = 0; i < no; i++) { srec *r = old[i];
+        LOG("[nvn] oldest live recording #%d: age %llu frames, %u intervals, first [%#llx, %#llx), %llu host bytes, %llu record bytes", i, (unsigned long long)(f - r->born), r->niv, (unsigned long long)(r->niv ? r->iv[0].lo : 0), (unsigned long long)(r->niv ? r->iv[0].hi : 0), (unsigned long long)r->bytes, (unsigned long long)r->rbytes); }
+    pthread_mutex_unlock(&g_sh_mu);
+}
+static void sh_evict(uint64_t f) {
+    static uint64_t capb, minage; static int init;
+    if (!init) { init = 1; const char *e = getenv("S2A_REC_CAP_MB"), *a = getenv("S2A_REC_AGE"); capb = e && *e ? strtoull(e, NULL, 10) << 20 : 0; minage = a && *a ? strtoull(a, NULL, 10) : 6000;
+        if (capb) LOG("[nvn] S2A_REC_CAP_MB: recordings older than %llu frames are freed, oldest first, while the live host blocks exceed %llu MB", (unsigned long long)minage, (unsigned long long)(capb >> 20)); }
+    if (!capb) return;
+    pthread_mutex_lock(&g_sh_mu);
+    while (g_sh_live_bytes > capb) { srec *r = g_sh_all.next; if (r == &g_sh_all || r->open || f - r->born < minage) break; sh_kill(r); g_sh_evicted++; }
+    pthread_mutex_unlock(&g_sh_mu);
+}
